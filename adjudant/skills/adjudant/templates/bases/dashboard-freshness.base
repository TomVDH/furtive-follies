filters:
  or:
    - file.inFolder("projects/{slug}/notes")
    - file.inFolder("projects/{slug}/decisions")
    - file.inFolder("projects/{slug}/references")
views:
  - type: table
    name: Longest unverified
    sort:
      - property: verified
        direction: ASC
    order:
      - file.name
      - type
      - verified
      - verified_by
      - updated
      - superseded_by
